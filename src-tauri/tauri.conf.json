{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YouCam",
  "version": "../package.json",
  "identifier": "com.codesignist.youcam",
  "build": {
    "beforeDevCommand": "pnpm exec vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm exec vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YouCam",
        "url": "index.html",
        "width": 250,
        "height": 250,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../assets/licenses/*": "licenses/"
    },
    "shortDescription": "A webcam app for YouTube users",
    "category": "Video"
  }
}
